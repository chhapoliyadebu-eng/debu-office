# ============================================================
# FRONTEND config — set these as Netlify Site environment variables
# (Netlify dashboard → Site configuration → Environment variables),
# and/or in a local .env file for `npm run dev`.
# ============================================================

# Firebase Console → Project Settings → General → Your apps → Web app.
# These are safe to expose in a frontend bundle (they're not secrets —
# access control is enforced by firestore.rules, not by hiding this config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# REQUIRED for the Netlify + Firebase Functions split setup (unlike a
# same-origin Firebase Hosting setup, there's no automatic /api/** rewrite
# here — frontend and backend are on different domains).
#
# Get this URL after running `firebase deploy --only functions`: the CLI
# prints the deployed function's URL, e.g.
#   https://api-abcd1234uc-uc.a.run.app
# (2nd-gen Cloud Functions get a Cloud Run-style URL — copy it exactly as
# printed, no trailing slash.) You can also find it in Firebase Console →
# Functions → the `api` function → its Trigger URL.
VITE_API_BASE_URL=

# For local dev against `firebase emulators:start` instead of the deployed
# function, use the emulator URL instead, e.g.:
# VITE_API_BASE_URL=http://127.0.0.1:5001/YOUR-PROJECT-ID/us-central1/api

# REQUIRED for the hardened production API. Register the web app in
# Firebase Console → App Check → reCAPTCHA v3 and paste the site key here.
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key


# ============================================================
# BACKEND secrets — NOT set here. These are Firebase Functions secrets,
# set via the CLI (never in this file, never in Netlify, never in the
# frontend bundle):
#
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set MAILBOX_ENC_KEY
#
# BACKEND config (not secret): set ALLOWED_ORIGIN as a Firebase parameter to
#   the exact Netlify/custom origin, e.g. https://your-site.netlify.app
#   Never use * for the authenticated production API.
#
# See DEPLOY.md for full instructions.
# ============================================================

# Production safety gate
VITE_APP_ENV=production

# Note: login is intentionally NOT restricted to an official email
# domain (any verified email can sign in; a Department Admin/Admin
# approves new accounts). The office MAILBOX still always uses a real
# government email, entered when connecting it — see MailboxSettings.
